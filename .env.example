# Core server
VEIL_HOST=127.0.0.1
VEIL_PORT=8080
VEIL_DEBUG=0

# OCR: auto | rapidocr | tesseract | none
VEIL_OCR_PROVIDER=auto

# Semantic provider: auto | heuristic | geniex_direct | geniex_server
VEIL_SEMANTIC_PROVIDER=auto
VEIL_SEMANTIC_MODEL=ai-hub-models/Qwen3-4B-Instruct-2507
VEIL_GENIEX_DEVICE_MAP=qairt
VEIL_GENIEX_BASE_URL=http://127.0.0.1:18181/v1

# Privacy/performance
VEIL_AUDIT_ENABLED=1
VEIL_RETAIN_RAW_TEXT=0
VEIL_PROCESS_INTERVAL_MS=450
VEIL_CHANGE_THRESHOLD=8.0
VEIL_TILE_SIZE=128
VEIL_CHANGE_PADDING=24
VEIL_REGION_TTL=1.2
VEIL_SEMANTIC_BATCH_SIZE=10
